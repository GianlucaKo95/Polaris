              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Raumfugen und Fugenfüllung herstellen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
        </Itemlist>
       </BoQBody>
      </BoQCtgy>
      <BoQCtgy ID="ID_34" RNoPart="02">
       <LblTx textWidth="9.997cm">
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">Markierungsarbeiten</span>
        </p>
       </LblTx>
       <BoQBody>
        <Itemlist>
         <Remark ID="ID_35">
          <Description ID="8751B41D-3825-49EE-8806-F0B72ECFA5D8">
           <CompleteText>
            <DetailTxt>
             <Text textWidth="9.997cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Markierungen im Bereich der erneuerten Betonfahrahnplatten wieder herstellen und im Bereich der verbliebenen Markierung ausbessern/erneuern.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Längsmarkierung der Stellplätze:</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Durchgehende Markierungslinie mit Strich ohne Lücken, Strichbreite 100 mm, </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Markierungsstoff und Ausführung unter</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Berücksichtigung des Bestandes, Angaben AG und</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">KABA.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Die Markierung ist entsprechen Bestand und Detail MA9 der KABA auszuführen. </span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Vorbemerkung</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Remark>
         <Item ID="ID_36" RNoPart="0010">
          <Qty>3.000</Qty>
          <QU>m2</QU>
          <CtlgAssign>
           <CtlgID>CtlgID_B12</CtlgID>
           <CtlgCode>131</CtlgCode>
          </CtlgAssign>
          <Description ID="B6A9533F-F6FE-4D0E-945B-B3C0382EE10B">
           <StLNo Type="StLK">2113111599</StLNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text textWidth="20cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Markierungsfläche auf neuer Betondecke vorbereiten. Ab-</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">fall aufnehmen und nach Wahl des AN verwerten. Abge-</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">rechnet wird die zu markierende Fläche. Bei Pfeil,</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Buchstabe, Ziffer, Verkehrsschild, und Piktogramm er-</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">gibt sich die Fläche aus dem kleinsten umschließenden</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Rechteck.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Vorbereiten mit </span>
               <TextComplement MarkLbl="21" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;">Verfahren nach Wahl AN</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Markierungsfläche vorbereiten </span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="ID_37" RNoPart="0020">
          <Qty>5.000</Qty>
          <QU>m</QU>
          <CtlgAssign>
           <CtlgID>CtlgID_B12</CtlgID>
           <CtlgCode>131</CtlgCode>
          </CtlgAssign>
          <Description ID="B8E8F282-D332-40B0-BC42-45294E7234F7">
           <StLNo Type="StLK">2113152512100103</StLNo>
           <CompleteText>
            <DetailTxt>
             <Text textWidth="20cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Parkflächenmarkierung und Grenzmarkierung für Halt- und</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Parkverbot Typ II als endgültige Markierung herstellen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Abgerechnet wird der markierte Strich.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Markierung = Parkmarkierung.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Strich ohne Vormarkierung.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Markierungssystem aus einkomponentiger lösemittelarmer</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Farbe (High-Solid).</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Verkehrsklasse mindestens P 6.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Markierung auf grobstrukturierter Betondecke.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Parkmarkierung Typ II herstellen Parkmarkierung ohne Vormarkier. einko</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="ID_291" RNoPart="0030">
          <Qty>1.000</Qty>
          <QU>St</QU>
          <CtlgAssign>
           <CtlgID>CtlgID_B12</CtlgID>
           <CtlgCode>131</CtlgCode>
          </CtlgAssign>
          <Description ID="F0BF3620-1D79-4A05-9E32-E05F1956BD0B">
           <StLNo Type="StLK">21131420311904</StLNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text textWidth="20cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Pfeilmarkierung Typ I als endgültige Markierung her-</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">stellen. Verkehrsklasse P 7.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Markierungszeichen = Pfeil geradeaus und links oder</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">rechts ab.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Mit Vormarkierung.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Länge = 2,00 m.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Markierungssystem aus </span>
               <TextComplement MarkLbl="51" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;">Markierungssystem aus einkomponentiger, lösungsmittelarmer Farbe (High-Solid)</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Markierung auf nicht grobstrukturierter Betondecke.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Pfeilmarkierung Typ I herstellen gerad.+li.o.re.ab mit Vormarkierung L</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
        </Itemlist>
       </BoQBody>
      </BoQCtgy>
      <BoQCtgy ID="ID_38" RNoPart="03">
       <LblTx textWidth="9.999cm">
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">Blitzschutz</span>
        </p>
       </LblTx>
       <BoQBody>
        <Itemlist>
         <Item ID="ID_39" RNoPart="0010">
          <Provis>WithTotal</Provis>
          <Qty>1.000</Qty>
          <QU>m</QU>
          <Description ID="DF0A085B-2298-4B3B-A2E6-29149739C118">
           <CompleteText>
            <DetailTxt>
             <Text textWidth="9.997cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Beschädigte Erdungsbänder bzw. Erdungsbänder nach Elt-</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Planung einschließlich aller erforderlichen</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Aufbrucharbeiten in der Stahlbetondecke und</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Demontagearbeiten ausbauen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Demontage einschließlich Abspitzen des zum Ausbau</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">notwendigen Restbetons der Fahrbahnplatte.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Die vorhandenen Erdungsanschlüsse aus Runddraht bzw.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Flachband sind entsprechend Erdungskonzept dabei</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">unbeschädigt zu erhalten.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Ausbau aus Fahrbahnplatte aus Beton mit Fahrbahn aus</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Gussasphalt sowie freiliegend aus Deckenuntersicht.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Nicht mehr benötigte Abbruchbereiche, Nute und Schlitze</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">sowie Dübellöcher von Verankerungen sind mit</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Betonersatz entsprechend LV mit Epoxidharzmörtel zu</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">verschließen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Mörtel bündig bis OK Rohbetondecke einbauen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Erdungsbänder ausbauen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="ID_40" RNoPart="0020">
          <Provis>WithTotal</Provis>
          <Qty>1.000</Qty>
          <QU>m</QU>
          <Description ID="EE385504-13F4-4051-A6BE-031FBBD1F875">
           <CompleteText>
            <DetailTxt>
             <Text textWidth="9.997cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Schutzerdungskonstruktion aus Runddraht oder Flachband</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">entsprechend Bestand und erdungstechnischer</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Erfordernisse nach Elt- Planung und Wahl des AN</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">einschließlich des Anschlusses an die Erdung von</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Fangpilzen, Lampenmasten und Blitzschutz auf</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Brüstungen/ Fassade usw. für begeh- und</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">befahrbare Flachdächer, DIN 48 832, Edelstahl, DIN 17</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">440, Werkstoff- Nr. 1.4571, komplett mit Anschluss- und</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">allen Zubehör, liefern und montieren.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Einbau in Fahrbahnplatte aus Beton mit Fahrbahn aus</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Gussasphalt, Oberfläche bündig soweit durch DIN- und</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">VDE- Normen sowie Montageanleitung zulässig.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Einbau der Erdungsdrähte aus Runddraht oder Flachband.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Ausführung einschließlich aller Stoss- und</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Eckausbildungen und mit Anschluss zur Befestigung der</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Erdungsdrähte einbauen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Material entsprechend Bestand oder Edelstahl,</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">DIN 17440, Werkstoff- Nr. 1.4571.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Schutzerdung durch Ankerschrauben mit Muttern und</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Unterlegscheiben aus nichtrostenden Stahl befestigen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Alle zu erdenten Bauteile wie Lampenmasten,</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Blitzableiter und übrigen Erdungsteile an zu schaffende</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">bzw. vorhandene Erdung anschließen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Die Erdungsleitungen sollten unter der Abdichtung</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">liegen, daher sind die erforderlichen Nuten/ Schlitze</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">in der Stahlbetondecke ca. 55 x 10 mm mit einzurechnen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Betonersatz der Aussparungen mit Erdungsleitungen</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">entsprechend LV mit Epoxidharzmörtel durchführen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Mörtel oberflächenbündig einbauen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Im Bereich der Gefällekeile werden die Erdungsleitungen</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">aus der Rohdecke in den Gefällekeilen verlegt.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Ausführung einschließlich erforderlicher Prüfungen und</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Abnahmen durch einen amtlich anerkannten</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Sachverständigen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Der AG und die BÜ sind rechtzeitig vor Prüfung zu</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">verständigen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Die Ergebnisse und Unterlagen der Prüfung sind dem AG</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">zu übergeben.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Schutzerdung herstellen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="ID_41" RNoPart="0030">
          <Provis>WithTotal</Provis>
          <Qty>1.000</Qty>
          <QU>m</QU>
          <CtlgAssign>
           <CtlgID>CtlgID_B12</CtlgID>
           <CtlgCode>123</CtlgCode>
          </CtlgAssign>
          <Description ID="AEB3DD61-BBDA-4C4B-9FE1-D55C6AF8452F">
           <StLNo Type="StLK">121231519199</StLNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text textWidth="9.997cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Verstärkungsstreifen nach Unterlagen des AG einbauen</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">und ggf. an Konstruktionen und Durchdringungskörper an-</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">schließen.</span>
              </p>
              <TextComplement MarkLbl="21" Kind="Owner" ArtChrIdent="0">
               <ComplCaption>
                <span style="font-family:Arial;font-size:10pt;">Einbau </span>
               </ComplCaption>
               <ComplBody>
                <span style="font-family:Arial;font-size:10pt;">unter den Erdungsbändern</span>
               </ComplBody>
               <ComplTail/>
              </TextComplement>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Stoff = edelstahlkaschierte Bitumen-Schweißbahn.</span>
              </p>
              <TextComplement MarkLbl="41" Kind="Owner" ArtChrIdent="0">
               <ComplCaption>
                <span style="font-family:Arial;font-size:10pt;">Breite </span>
               </ComplCaption>
               <ComplBody>
                <span style="font-family:Arial;font-size:10pt;">10 cm </span>
               </ComplBody>
               <ComplTail/>
              </TextComplement>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Verstärkungsstreifen einbauen Schweißbn.kasch. (PAD1)</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
        </Itemlist>
       </BoQBody>
      </BoQCtgy>
     </BoQBody>
    </BoQCtgy>
    <BoQCtgy ID="ID_42" RNoPart="03">
     <LblTx textWidth="9.999cm">
      <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
       <span style="font-family:Arial;font-size:10pt;">Instandsetzung Randbereich</span>
      </p>
     </LblTx>
     <BoQBody>
      <Remark ID="ID_43">
       <Description ID="52175827-6D7A-4EC8-91D2-7D1EDFE7002D">
        <CompleteText>
         <DetailTxt>
          <Text textWidth="9.997cm">
           <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
            <span style="font-family:Arial;font-size:10pt;">Die nachfolgenden Positionen beinhalten die Erneuerung der Abdichtungsanschlüsse an den aufgehenden Außenwänden auf dem Parkdeck im Baubereich 1. </span>
           </p>
           <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
            <span style="font-family:Arial;font-size:10pt;">Die Leistungen umfassen den Rückbau der Fahrbahnplatten im unmittelbaren Randbereich vor der Außenwand auf dem Parkdeck..</span>
           </p>
           <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
           <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
            <span style="font-family:Arial;font-size:10pt;">Ein konstruktives Einschneiden der Fahrbahnplatten durch den AN ist zulässig, wenn die benachbarten Fahrbahnplatten nicht beschädigt werden und die darunter liegende Abdichtung durch die Trennschnitte nicht beschädigt wird. Das konstruktive und technologisch bedingte Trennschneiden ist in die Abbruchposition der Fahrbahnplatte einzurechnen.</span>
           </p>
           <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
            <span style="font-family:Arial;font-size:10pt;">Schäden an der Abdichtung und benachbarter Platten, die durch das Trennenschneiden verursacht werden, sind auf Kosten des AN zu sanieren. </span>
           </p>
           <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
           <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
            <span style="font-family:Arial;font-size:10pt;">Die Abdichtungslagen sowie die Wärmedämmung sind auf einem Streifen mit einer Breite von ca. 1,0m vor der Außenwand aufzunehmen. </span>
           </p>
           <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
            <span style="font-family:Arial;font-size:10pt;">Zur Sicherstellung der erforderlichen Abdichtungsanschlüsse und Überlappungen zu verbleibenden Abdichtungslagen sind diese mit mindestens 20 cm Versatz auszubauen.</span>
           </p>
          </Text>
         </DetailTxt>
         <OutlineText>
          <OutlTxt>
           <TextOutlTxt>
            <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
             <span>Vorbemerkung</span>
            </p>
           </TextOutlTxt>
          </OutlTxt>
         </OutlineText>
        </CompleteText>
       </Description>
      </Remark>
      <BoQCtgy ID="ID_44" RNoPart="01">
       <LblTx textWidth="9.997cm">
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">Abdichtungsarbeiten und Wärmedämmung</span>
        </p>
       </LblTx>
       <BoQBody>
        <Itemlist>
         <Item ID="ID_45" RNoPart="0010">
          <Qty>25.000</Qty>
          <QU>m2</QU>
          <Description ID="8245B89A-492D-4A6B-8EBE-380A8B0440E6">
           <StLNo Type="StLK">1212300392140111</StLNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text textWidth="9.997cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Abdichtung nach Unterlagen des AG aufnehmen. Erforder-</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">liche Trennschnitte herstellen.</span>
              </p>
              <TextComplement MarkLbl="10" Kind="Owner" ArtChrIdent="0">
               <ComplCaption>
                <span style="font-family:Arial;font-size:10pt;">Abdichtung auf </span>
               </ComplCaption>
               <ComplBody>
                <span style="font-family:Arial;font-size:10pt;">wärmegedämmten Parkdeck unterhalb der Betonfahrbahnplatten.</span>
                <br/>
                <span style="font-family:Arial;font-size:10pt;">Ausbau einschließlich senkrechter Dichtungshochzüge.</span>
               </ComplBody>
               <ComplTail>
                <span style="font-family:Arial;font-size:10pt;"> </span>
               </ComplTail>
              </TextComplement>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Dichtungsschicht = Bitumendichtungsbahn 2-lagig.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Schutzlage aus Bitumendachbahn einschl. Verstärkungs-</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">streifen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Schutzschicht = Beton.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Ausführung in Teilflächen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Dichtungsschicht im Anschlussbereich auf einer Breite</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">von ca. 30 cm unbeschädigt erhalten.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Ausgebaute Stoffe der Verwertung nach Wahl des AN zu-</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">führen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Abdichtung aufnehmen Dichtungsbahn Schutzl.+Verstär. Beton Teilflächen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="ID_46" RNoPart="0020">
          <Qty>15.000</Qty>
          <QU>m2</QU>
          <Description ID="E721BA62-4B86-431D-BD05-62D294956F03">
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text textWidth="9.997cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Wärmedämmung nach Unterlagen des AG aufnehmen. </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Erforderliche Trennschnitte herstellen.</span>
              </p>
              <TextComplement MarkLbl="61" Kind="Owner" ArtChrIdent="0">
               <ComplCaption>
                <span style="font-family:Arial;font-size:10pt;">Wärmedämmung auf </span>
               </ComplCaption>
               <ComplBody>
                <span style="font-family:Arial;font-size:10pt;"> Parkdeck. Wärmedämmung aus Polystyrol o.ä.Dicke ca.  8 bis 12cm. Ausführung in Teilflächen.Ausgebaute Stoffe der Verwertung nach Wahl des ANzuführen.</span>
               </ComplBody>
               <ComplTail>
                <span style="font-family:Arial;font-size:10pt;"> </span>
               </ComplTail>
              </TextComplement>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Die unter der Wärmedämmung vorhandene</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Abdichtungslage/Notabdichtung ist im verbleibenden </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Anschlussbereich unbeschädigt zu erhalten.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Ausbau der Wärmedämmung hat mit besonderer Sorgfalt und</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Vorsicht zu erfolgen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Es ist mit Erschwernissen beim Ausbau der Dämmung durch</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">das ankleben der Platten durch Bitumen, Abdichtungen </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">o.ä. zu rechnen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Diese Erschwernisse sind in diese Position mit</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">einzurechnen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Wärmedämmung aufnehmen, Teilflächen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="ID_47" RNoPart="0030">
          <Qty>25.000</Qty>
          <QU>m2</QU>
          <CtlgAssign>
           <CtlgID>CtlgID_B12</CtlgID>
           <CtlgCode>123</CtlgCode>
          </CtlgAssign>
          <Description ID="2724783D-C0EB-4180-93A4-48BE60792FF0">
           <StLNo Type="StLK">1212300399000111</StLNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text textWidth="19.998cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Abdichtung nach Unterlagen des AG aufnehmen. Erforder-</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">liche Trennschnitte herstellen.</span>
              </p>
              <TextComplement MarkLbl="21" Kind="Owner" ArtChrIdent="32767">
               <ComplCaption>
                <span style="font-family:Arial;font-size:10pt;">Abdichtung auf </span>
               </ComplCaption>
               <ComplBody>
                <span style="font-family:Arial;font-size:10pt;">Rohdecke des Parkdecks</span>
               </ComplBody>
               <ComplTail/>
              </TextComplement>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <TextComplement MarkLbl="31" Kind="Owner" ArtChrIdent="32767">
               <ComplCaption>
                <span style="font-family:Arial;font-size:10pt;">Dichtungsschicht </span>
               </ComplCaption>
               <ComplBody>
                <span style="font-family:Arial;font-size:10pt;">Notabdichtung bzw. Dampfsperrebestehend </span>
                <br/>
                <span style="font-family:Arial;font-size:10pt;">aus Bitumenvoranstrich und Bitumenbahn.</span>
                <br/>
                <span style="font-family:Arial;font-size:10pt;">Ausbau einschließlich eventueller senkrechter Dichtungshochzüge</span>
               </ComplBody>
               <ComplTail/>
              </TextComplement>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Ausführung in Teilflächen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Dichtungsschicht im Anschlussbereich auf einer Breite</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">von ca. 30 cm unbeschädigt erhalten.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Ausgebaute Stoffe der Verwertung nach Wahl des AN zu-</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">führen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Abdichtung aufnehmen Teilflächen Dichtungsanschl. Verwerten</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="ID_48" RNoPart="0040">
          <Provis>WithTotal</Provis>
          <Qty>10.000</Qty>
          <QU>m2</QU>
          <CtlgAssign>
           <CtlgID>CtlgID_B12</CtlgID>
           <CtlgCode>123</CtlgCode>
          </CtlgAssign>
          <Description ID="0A3AC8E6-644F-4385-884C-B4CCE8D7025A">
           <StLNo Type="StLK">121231239001</StLNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text textWidth="19.998cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Dichtungsschicht aus einer Bitumen-Schweißbahn gemäß</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">ZTV-ING, Teil 7, Abschnitt 1 nach Unterlagen des AG</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">herstellen. Dichtungsschicht an bestehende Abdichtun-</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">gen, Konstruktionen, Durchdringungskörper und sonstige</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Einbauten anschließen. Anschlussflächen sind vorzube-</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">reiten. Das Einbauen von Verstärkungsstreifen und</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Schutzlage wird gesondert vergütet.</span>
              </p>
              <TextComplement MarkLbl="21" Kind="Owner" ArtChrIdent="32767">
               <ComplCaption>
                <span style="font-family:Arial;font-size:10pt;">Bauteil </span>
               </ComplCaption>
               <ComplBody>
                <span style="font-family:Arial;font-size:10pt;">freigelegte Wärmedämmung des Parkdecks im </span>
                <br/>
                <span style="font-family:Arial;font-size:10pt;">Überlappungsbereich.</span>
                <br/>
                <span style="font-family:Arial;font-size:10pt;">Einbau einer provisorischen, bauzeitlichen Abdichtung</span>
                <br/>
                <span style="font-family:Arial;font-size:10pt;">zum Schutz vor Nässe und Wasser, </span>
                <br/>
                <span style="font-family:Arial;font-size:10pt;">welches in die Wärmedämmebene eindringen kann.</span>
               </ComplBody>
               <ComplTail/>
              </TextComplement>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Ausführung in Teilflächen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Dichtungssch. aus 1 Bitbahn herst. Teilflächen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Remark ID="ID_49">
          <Description ID="1E3C4955-5CED-4751-810E-759ECC559E9A">
           <CompleteText>
            <DetailTxt>
             <Text textWidth="9.997cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Abdichtung und Wärmedämmung für Parkdeck  </span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;">über beheizten Räumen entsprechend Bestand sowie nach dem </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">KABA Parkdeck-Fahrbahnbelag PFB sowie Parkdeck Abdichtung PAD1 und Parkdeck Wärmedämmung PWD1 nach Wahl AN herstellen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Dichtungsschichten an bestehende Abdichtungen und</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Konstruktionen sowie an Durchdringungskörper</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">anschließen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Bauteil: Parkdeck im 1. OG aus Stahlbeton im Bereich </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">der Brüstung gegenüber des Eingange (Baubereich 1). </span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Vorbemerkung Abdichtung und Wärmedämmung</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Remark>
         <Item ID="ID_50" RNoPart="0050">
          <Qty>15.000</Qty>
          <QU>m2</QU>
          <Description ID="06B4B201-8532-4ECC-87E5-BC95C775CAEF">
           <CompleteText>
            <DetailTxt>
             <Text textWidth="9.997cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Bitumenvoranstrich auf der Deckunterlage aus Beton zur </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Staubbindung und Haftvermittlung mit PC 3 A </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">herstellen. </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Bitumenvoranstrich in der Menge von ca. 0,3 l/m2 </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">vollflächig einstreichen/ spritzen und gut </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">durchtrocknen lassen. </span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Bitumenvoranstrich</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="ID_51" RNoPart="0060">
          <Qty>15.000</Qty>
          <QU>m2</QU>
          <Description ID="E1C984F6-2E28-47CA-BFB9-9C1E56480D66">
           <CompleteText>
            <DetailTxt>
             <Text textWidth="9.997cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Dampfsperrbahn/Notabdichtung liefern und fachgerecht einbauen. </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Dampfsperrbahn aus 1 Lage Bitumen-Schweißbahn G 200 S 5 nach DIN 52131, 5 mm dick, Trägereinlage aus Glasgewebe 200 g/m2, mit mind. 8 cm Naht- und Stoßüberdeckung vollflächig und hohlraumfrei verschweißen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Dampfsperrbahn/Notabdichtung</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="ID_52" RNoPart="0070">
          <Qty>15.000</Qty>
          <QU>m</QU>
          <Description ID="7AD84DBC-984D-490E-ABC9-68F5CD2B798F">
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text textWidth="9.997cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Dichtungsschicht aus Flüssigkunststoff gemäß ZTV-BEL-B</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Teil 3 / ZTV- ING Teil 3, Abschnitt 7 / OS10 in Anlehnung an RiLi-SIB/ TRI herstellen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Abdichtung 3- lagig mit Vlieseinlage. </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Ggf. erforderliche Haftbrücke und</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">ggf. erforderliche Verbindungsschicht zur Schutzschicht</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">auftragen. Dichtungsschicht an bestehende Abdichtungen</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">und Konstruktionen sowie Durchdringungskörper anschlie-</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">ßen. Ggf. überschüssiges Abstreumaterial in Eigentum</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">des AN übernehmen und von der Baustelle entfernen.</span>
              </p>
              <TextComplement MarkLbl="61" Kind="Owner" ArtChrIdent="0">
               <ComplCaption>
                <span style="font-family:Arial;font-size:10pt;">Bauteil </span>
               </ComplCaption>
               <ComplBody>
                <span style="font-family:Arial;font-size:10pt;"> Parkdeck 1. OG = DG aus Stahlbeton. Ausführung unter Wärmedämmung einschließlich in Randbereichen mit aufgehenden Bauteilen wie Wänden usw. Ausführung als Dichtungsanschluss unter der Wärmedämmung einschließlich zum aufgehenden Bauteil nach Zeichnung.</span>
               </ComplBody>
               <ComplTail>
                <span style="font-family:Arial;font-size:10pt;"> Ausführung in Teilflächen.</span>
               </ComplTail>
              </TextComplement>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Trennschicht für die Überbrückung von Fugen vor dem</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Aufbringen der Dichtungsschicht herstellen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Dichtungsschicht im Überbrückungsbereich verstärken.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Breite und Länge der Fugen nach Zeichnung.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Randabdichtung als Dichtungssch.a.Flüsskunstst.herst.</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="ID_53" RNoPart="0080">
          <Qty>15.000</Qty>
          <QU>m2</QU>
          <Description ID="DE2BEA5D-5414-4BDC-A0DF-8AE6CA267991">
           <CompleteText>
            <DetailTxt>
             <Text textWidth="9.997cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Wärmedämmung für Parkdach gemäß Kaufland Baubeschreibung KABA PWD1 liefern und fachgerecht einbauen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Parkdachwärmedämmung, druckfeste Wärmedämmung nach DIN EN 13164, für PKW-genutzte Dachflächen, aus extrudier-</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">tem Polystyrol-Hartschaum, Typ XPS 035 DAA-ds. Dämmstoffdicke mind. 120 mm, mit einem umlaufenden Stufenfalz von mindestens 20 mm, Druckspannung bei 10% Stauchung = 500 kPa nach DIN 826. Brandklasse DIN 4102-B1, Dämmstoffplatten auf der Abdichtung fachgerecht gemäß Herstellervorschrift verlegen. </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Dicke der Wärmedämmung ist abhängig von der Bestandsdicke, Bestandsdicke ist maßgebend für Einbaudicke.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Wärmedämmung einbauen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="ID_54" RNoPart="0090">
          <Qty>25.000</Qty>
          <QU>m2</QU>
          <Description ID="4D6873BC-561F-425B-8700-4F18B1AE88BD">
           <CompleteText>
            <DetailTxt>
             <Text textWidth="9.997cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Zweilagige Parkdachabdichtung, Oberlage aus einer hochwertigen Elastomerbitumen-Schweißbahn PYE-PV 200 S 5 nach DIN 52133, 5 mm dick, jedoch Kältebeständigkeit -30°C, mit mind. 8 cm Naht- und Stoßüberdeckung vollflächig und hohlraumfrei verschweißen, 1. Lage aus einer hochwertigen Elastomerbitumenbahn als kaltselbstklebende Sonderbahn, </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">4 mm dick, mit 207 einer Trägereinlage aus </span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;">Gittergelege 200 g/m², Kältebiegebeständigkeit -30°C, verlegen. Im Überlappungsbereich ist die Bahn zusätzlich, mit einem speziellen Naht-Flämmgerät, welches die Wärmedämmung nicht gefährdet, zu schweißen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>2-lagige Abdichtung aus Elastomerbitumenbahn herstellen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="ID_55" RNoPart="0100">
          <Qty>15.000</Qty>
          <QU>m</QU>
          <Description ID="2A1034D3-EE01-41D4-9157-34F6C72AF226">
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text textWidth="9.997cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Dichtungsschicht aus Flüssigkunststoff gemäß ZTV-BEL-B</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Teil 3 / ZTV- ING Teil 3, Abschnitt 7 / OS10 in Anlehnung an RiLi-SIB/ TRI herstellen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Abdichtung 3- lagig mit Vlieseinlage.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Ggf. erforderliche Haftbrücke und ggf. erforderliche Verbindungsschicht zur Schutzschicht auftragen. Dichtungsschicht an bestehende Abdichtungen</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">und Konstruktionen sowie Durchdringungskörper anschlie-</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">ßen. Ggf. überschüssiges Abstreumaterial in Eigentum</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">des AN übernehmen und von der Baustelle entfernen.</span>
              </p>
              <TextComplement MarkLbl="61" Kind="Owner" ArtChrIdent="0">
               <ComplCaption>
                <span style="font-family:Arial;font-size:10pt;">Bauteil </span>
               </ComplCaption>
               <ComplBody>
                <span style="font-family:Arial;font-size:10pt;"> Parkdeck 1. OG = DG aus Stahlbeton. Ausführung im Bereich der Undichtigkeiten einschließlich in Randbereichen mit aufgehenden Bauteilen wie Wänden usw. </span>
                <br/>
                <span style="font-family:Arial;font-size:10pt;">Ausführung auf der Bitumenschweißbahn einschließlich des Dichtungsanschlusses zum aufgehenden Bauteil nach Zeichnung.</span>
               </ComplBody>
               <ComplTail>
                <span style="font-family:Arial;font-size:10pt;"> Ausführung in Teilflächen.</span>
               </ComplTail>
              </TextComplement>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Trennschicht für die Überbrückung von Fugen vor dem</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Aufbringen der Dichtungsschicht herstellen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Dichtungsschicht im Überbrückungsbereich verstärken.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Breite und</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Länge der Fugen nach Zeichnung.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>2 lagigen Randanschluss als Dichtungssch.a.Flüsskunstst.herst.</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
        </Itemlist>
       </BoQBody>
      </BoQCtgy>
      <BoQCtgy ID="ID_56" RNoPart="02">
       <LblTx textWidth="9.997cm">
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">Betonf</span>
        </p>
       </LblTx>
       <BoQBody>
        <Itemlist>
         <Item ID="ID_57" RNoPart="0010">
          <Qty>70.000</Qty>
          <QU>m2</QU>
          <CtlgAssign>
           <CtlgID>CtlgID_B12</CtlgID>
           <CtlgCode>118</CtlgCode>
          </CtlgAssign>
          <Description ID="077A51DA-FFA7-420C-BC04-AF51B89ACFA5">
           <StLNo Type="StLK">1611801892392102</StLNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text textWidth="9.997cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Beton nach Unterlagen des AG abbrechen.</span>
              </p>
              <TextComplement MarkLbl="21" Kind="Owner" ArtChrIdent="0">
               <ComplCaption>
                <span style="font-family:Arial;font-size:10pt;">Bauteil </span>
               </ComplCaption>
               <ComplBody>
                <span style="font-family:Arial;font-size:10pt;">Betonfahrbahnplatten im Randbereich</span>
               </ComplBody>
               <ComplTail/>
              </TextComplement>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Material = Beton, mit geringer Bewehrung.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Druckfestigkeitsklasse über C20/25 bis C35/45.</span>
              </p>
              <TextComplement MarkLbl="51" Kind="Owner" ArtChrIdent="0">
               <ComplCaption>
                <span style="font-family:Arial;font-size:10pt;">Abbruchdicke </span>
               </ComplCaption>
               <ComplBody>
                <span style="font-family:Arial;font-size:10pt;">ca. 12 - 15 cm.</span>
               </ComplBody>
               <ComplTail/>
              </TextComplement>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Abbruch ohne Erschütterungen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Beton in Teilbereichen abbrechen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Abbruchgut der Verwertung nach Wahl des AN zuführen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Für nicht gefährlichen Abfall Nachweis nach Unterlagen</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">des AG führen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Beton abbrechen. Ger.bewehrt.Beton C20/25 bis C35/45 O.Erschütterung T</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="ID_297" RNoPart="0020">
          <Qty>70.000</Qty>
          <QU>m2</QU>
          <Description ID="231C094C-9F37-4CA5-8087-43E511D4FFF3">
           <CompleteText>
            <DetailTxt>
             <Text textWidth="20cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">PE- Folie und Trennlage aus Schaummatte, Geotextil o.glw. nach Unterlagen des AG aufnehmen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Folie auf Abdichtung unter Betonplattenbelag.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Ausführung in Teilflächen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Ausgebaute Stoffe der Verwertung nach Wahl des AN</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">zuführen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Folie und Trennlage aufnehmen Unter Betonplatten Verwerten</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="ID_59" RNoPart="0030">
          <Qty>70.000</Qty>
          <QU>m2</QU>
          <Description ID="084211EC-4C42-433F-ACA5-5443621E122A">
           <CompleteText>
            <DetailTxt>
             <Text textWidth="9.997cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Trenn- und Gleitfolie unter Betonplatten nach KABA PAD1 herstellen</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Trenn-/Gleitschicht nach DIN 18195 Teil 10, bestehend aus 1 Lage PE-Folie 0,2 mm und 1 Lage PE-Schaummatte 3 mm (ETHA-FOAM / Gefinex oder gleichwertig) oder Geotextil / Polyestervlies, verrottungsfest, mind. 150 g/m² (Vliepa PES 150 oder gleichwertig).</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Trenn- und Gleitfolie herstellen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="ID_60" RNoPart="0040">
          <Qty>70.000</Qty>
          <QU>m2</QU>
          <Description ID="D17C12BB-8A4F-4263-B74C-853445AC0011">
           <CompleteText>
            <DetailTxt>
             <Text textWidth="9.997cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Betonplattenfahrbahn für Parkdeck über beheizten Räumen</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">entsprechend Bestand und KABA 2025 herstellen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Einsatzort in Verkehrs- und Parkflächen mit besonderen</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Beanspruchungen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Einbau in Bauwerk (Parkdeck) auf Decke mit Abdichtung</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">und Wärmedämmung über beheizten Räumen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Betonfahrbahnbelag nach KABA PFB1:</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Oberflächenvergütung mittels chemischer Verdichtung zur Reduzierung der Oberflächenporosität und Verbesserung der Betoneigenschaften, wie z.B. Verschleißfestigkeit, Frost- und Tausalzbeständigkeit, Material z.B. POBURSKI Polytop, Ashford Formula (AF) oder Bagrat ISO-110 nach Herstellervorgaben aufbringen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Beton-Fahrbahnbelag. Beton gemäß DIN 1045-2 / DIN EN 206 mit hohem Frost- und Tausalzwiderstand und hoher Verschleiß-</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">festigkeit in der Oberfläche (XF4, XM2, WA). Ergänzend wird gefordert, dass die Gesteinskörnung (8 mm) aus Edelsplitt be-</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">steht. Die Gesteinskörnungen müssen die Anforderungen der DIN EN 12620: 202 - Betonzuschlag mit hohem Frost- und Tau-</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">salzwiderstand erfüllen. </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Die Oberfläche des Betonbelages ist mit einem feinen Besenstrich auszubilden. Der Besenstrichfolgt der Neigung der vorhandenen Decken- und Abdichtungskonstruktion mit ca. 2 % Gefälle. </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Die Fahrbahnmarkierungen sollen möglichst parallel zu den Rasterfugen verlaufen. </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Betongüte C30/37 LP oder Einbau einer Betongüte C35/45. Der verwendete Beton muss verbesserten Eigenschaften wie: verminderte Wasseraufnahme, höhere Druckfestigkeit, hoher Frost- und Tausalzwiderstand besitzen.Die Qualität des eingebauten Transportbetons ist durch eine Eigenüberwachung gemäß ÜK2 (DIN 1045-3) prüfbar zu dokumentieren. Die Prüfprotokolle sind dem Auftraggeber in 2-facher Ausfertigung zu übergeben (Im Rahmen der Dokumentationsunterlagen).</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;text-decoration:underline;font-size:10pt;">Betonklassifzierung nach DIN 1045-2 / DIN EN 206.1</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;"> Frost- und Taumittelangriff: XF4, hohe Wassersättigung mit Taumittel</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;"> Betonkorrosion durch Verschleißbeanspruchung: XM2, starker Verschleiß, Zementart: CEM l, Zementgüte: mind. 42,5 R</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;text-decoration:underline;font-size:10pt;">Betonzusammensetzung</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;"> maximaler Wasserzementfaktor: max. w/z = 0,45 (u.a. aus XM2)</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;"> Mindestzementgehalt: min. z = 350 kg/m3</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;"> Größtkorn aus Edelsplitt z. B. Diabas: 8 - 16 mm</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;"> Mindestdruckfestigkeitsklasse: C 30/37 (u.a. aus XM2 bei Verwendung von Luftporen)</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Das Fugenraster und die Plattengröße sind an das vorhandene Plattenraster anzupassen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Die Betondicke beträgt min. 12 cm. Die Bestandsstärke der vorhandenen Fahrbahnplatten ist maßgebend für die neuen Betonfahrbahnplatten. </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Das Fugenraster ist entsprechend des vorhandenen Platten-/Fugenrasters herzustellen. Die Größe der einzelnen Betonfelder im Randbereich betragen ca. 3,00 x 3,50 m</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Betonplattenfahrbahn für Parkdeck über beheizten Räumen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="ID_61" RNoPart="0050">
          <Qty>70.000</Qty>
          <QU>m2</QU>
          <CtlgAssign>
           <CtlgID>CtlgID_B12</CtlgID>
           <CtlgCode>124</CtlgCode>
          </CtlgAssign>
          <Description ID="11C3EEDD-CE67-4555-9E76-1EA6B600E851">
           <CompleteText>
            <DetailTxt>
             <Text textWidth="20cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Nachbehandeln der Betonplatten mit einen Nachbehandlungsmittel als Verdunstungsschutz für befahrene Bauteile im Verkehrswegebau z.B. aus wässrige Paraffindispersion für den Auftrag auf den mattfeuchten Beton.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Ausführung in Teilflächen nach Unterlagen des AG.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Schutz gegen Austrocknung Verbesserung der Festigkeit und Dauerhaftigkeit der Betonoberfläche. </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Verhinderung von Schrumpf- und Schwindrissen. </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">PRODUKTEIGENSCHAFTEN </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">■  hoher Verdunstungsschutz </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">■ Hohe Sperrwirkung (SM ≥ 85 %) </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">■ Ermöglicht einen optimalen Hydratationsverlauf in der </span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;">  obersten Betonschicht </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">■ Minimiert die Bildung von Frühschwindrissen </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">■ Schnelle Trocknung </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">■ Zertifiziert nach TL NBM-StB 09, Typ VM </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">ANWENDUNGSGEBIETE </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">■ Betonnachbehandlung von frisch hergestelltem Beton </span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;">   nach TM NBM-StB 09, Typ VM </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">■ Betonnachbehandlung für den Verkehrswegebau, </span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;"> . Straßenbau, Parkflächen ■ Betonnachbehandlung für </span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;">   befahrene Bauteile mit Griffigkeitsanforderungen </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">■ Für den Auftrag auf den mattfeuchten Beton (Sobald der sichtbare Wasserfilm verschwunden ist und die Betonoberfläche mattfeucht erscheint.) </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">KENNWERTE</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">- Dichte kg/dm³ ca. 0,98 </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">- Viskosität Sekunden 11 kinematisch nach DIN 53211 </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">- Verbrauch g/m² ca. 250 </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">- Trocknungszeit Stunden 4,5 </span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">- klebfrei Sperrkoeffizient ca. 87 TL NBM-StB 0</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Betonunterlage Nachbehandeln Betonplatten Teilflächen </span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
        </Itemlist>
       </BoQBody>
      </BoQCtgy>
      <BoQCtgy ID="ID_62" RNoPart="03">
       <LblTx>
        <span>Blecharbeiten und Spl</span>
       </LblTx>
       <BoQBody>
        <Itemlist>
         <Item ID="ID_63" RNoPart="0010">
          <Qty>16.000</Qty>
          <QU>m</QU>
          <Description ID="91054DDC-6B10-4765-A66A-340DB67BE516">
           <CompleteText>
            <DetailTxt>
             <Text textWidth="9.997cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Stahlblechabdeckung (Trittschutzblech) an Brüstungen</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">abbauen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Sämtliche Befestigungen bestehend aus Schrauben und</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Dübel entfernen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Dauerelastische Fugenmasse und andere Dichtbänder usw.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">ausbauen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Ggf. verbleibende Ankerlöcher mit PC- Mörtel</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">verschließen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Abbruchgut in Eingentum des AN nehmen und von Baustelle</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">entfernen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Dichtungsanschlüsse an aufgehende Bauteile unbeschädigt</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">erhalten.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Trittschutzblech demontieren</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="ID_64" RNoPart="0020">
          <Qty>16.000</Qty>
          <QU>m</QU>
          <Description ID="F0F4BE82-9F42-4916-AAD2-0E5F0B8F3DAB">
           <CompleteText>
            <DetailTxt>
             <Text textWidth="9.997cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Fußleiste aus Stahlblechabdeckung entsprechend Bestand</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">und KABA herstellen und einbauen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Einbauort = aufgehende Wände, Brüstungen und Sockel</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">usw. im Instandsetzungsbereich.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Fußleiste im Radius und Gefälle des Betonplattenbelags</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">einbauen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Abdeckung aus Stahlblech, feuerverzinkt, glatt, gem.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Bestand mit Schrauben/ Ankern und elastomeren</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Dichtungsbändern nach Zeichnung Liefern und Einbauen/</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Befestigen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Ggf. zusätzliche Abdichtung mit dauerelasischen</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Metrial.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Befestigungsteile aus nicht rostendem Stahl DIN 17 440,</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Stahlsorte A5, Werkstoff-Nr. 1.4571.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Obere V- förmige Fuge im Fußblech mit Fugenmasse</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">verfüllen. Wandungen mit geeignetem Voranstrich</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">versehen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Material = Polysulfid, tatsächliche</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Dauerbewegungsaufnahme min. 25 v.H, z.B. SikaTank PK-22</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">oder gleichwertiges.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Fugenwandungen Stahlblech und Mauerwek/ Beton.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Fugenbreite über 15 bis 25 mm.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Fülltiefe = 25 mm.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Herstellung einschließlich der erforderlichen</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">wasserdichten Anschlüsse zu den senkrechten Fugen mit</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">dauerlastischen Abdichtungen, Fugenbändern und</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Dehnprofilen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Ggf. können Aussparungen und Eindichtungen für</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Blitzableitung, Türzargen und andere Einbauteile</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">erforderlich werden.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Die dafür erforderlichen Mehraufwendungen sind mit</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">einzukalkulieren.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Skizze Randblech nach KABA Detail D11_5_1</span>
               <br/>
