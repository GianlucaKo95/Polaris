          </Description>
         </Item>
         <Item ID="ID_299" RNoPart="0030">
          <Qty>16.000</Qty>
          <QU>m</QU>
          <CtlgAssign>
           <CtlgID>CtlgID_B12</CtlgID>
           <CtlgCode>129</CtlgCode>
          </CtlgAssign>
          <Description ID="E26B1897-A1EE-417F-8099-4362F1CB76EE">
           <CompleteText>
            <DetailTxt>
             <Text textWidth="20cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Schutzeinrichtung (SE) aus Stahl einschließlich sämtli-</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">cher Einzelteile abbauen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">SE = Einfache Schutzplanke.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Holm Profil A.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Mit Pfosten, Abstand = 2,50 m.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Pfosten mit Fußplatte, einschließlich Entfernen der</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Ausgleichsschicht und Verankerung, Anker freilegen, 3cm</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">unter Oberkante Beton abtrennen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Konstruktionsteile innerhalb der Baustelle sortiert</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">nach Unterlagen des AG lagern.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>SE aus Stahl abbauen ESP Profil A Pfost. A 1,33 m Pfost.in bef.Fl. Ver</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="ID_300" RNoPart="0040">
          <Qty>16.000</Qty>
          <QU>m</QU>
          <CtlgAssign>
           <CtlgID>CtlgID_B12</CtlgID>
           <CtlgCode>129</CtlgCode>
          </CtlgAssign>
          <Description ID="0A279015-FCC0-4900-8CCC-077D6A6E7C22">
           <CompleteText>
            <DetailTxt>
             <Text textWidth="20cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Schutzeinrichtung (SE) des AG aufstellen. Verbindungs-</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">mittel liefert AN.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">SE = Einfache Schutzplanke, Holm A.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Pfostenabstand 2,50 m.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Aufstellung auf Anlieferung .</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Teile lagern innerhalb der Baustelle.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Schutzeinrichtung (SE) auf Anlieferung einschließlich ggf. erforderlicher systembedingter Befestigung herstellen. Abgerechnet</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">wird die Baulänge.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Neigung der Aufstellfläche bis einschl. 3 v.H.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>SE des AG aufstellen ESP Holm A Pf.Abstand 1,33 m HB 1 innerh.Baustell</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="ID_301" RNoPart="0050">
          <Qty>6.000</Qty>
          <QU>St</QU>
          <CtlgAssign>
           <CtlgID>CtlgID_B12</CtlgID>
           <CtlgCode>121</CtlgCode>
          </CtlgAssign>
          <Description ID="C00B559B-CBF7-4266-ABEA-A824A1C83EBC">
           <CompleteText>
            <DetailTxt>
             <Text textWidth="20cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Verankerung des AG aus Stahl entsprechend statischen und konstruktiven Erfordernissen nach Unterlagen des AG</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">einbauen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Verankerung für Schutzplankenpfosten.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Material der Ankerteile und Verbindungsmittel aus</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">nichtrostendem Stahl, Stahlsorte A4 oder A5 bzw.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Werkstoff-Nr. 1.4401 oder 1.4571 liefern und einbauen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Verankerung vor dem Betonieren einsetzen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Verankerung = 6 Fußplatten mit 4 Anker = 24 Anker</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Verankerung des AG einbauen Schutzplankenpf. Stahl, n.rostend</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
        </Itemlist>
       </BoQBody>
      </BoQCtgy>
      <BoQCtgy ID="ID_65" RNoPart="04">
       <LblTx textWidth="9.997cm">
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">Beschichtungsstoff auf freiliegenden Betonstahl und</span>
        </p>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">ggf. andere Stahlteile auftragen.</span>
        </p>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">Betonstahl vorbereiten wird gesondert vergütet.</span>
        </p>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">Beschichtung als Korrosionsschutz von an/ in der</span>
        </p>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">Oberfläche der Fahrbahnplatte aus Stahlbeton</span>
        </p>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">freigelegten bzw. freiliegender Bewehrung, die aufgrund</span>
        </p>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">des unveränderten Beibehalten der vorhandenen Höhen und</span>
        </p>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">Gefälle nicht mit einem Betonersatz für einer</span>
        </p>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">ausreichenden Betondeckung (min. 3,0 cm) überdeckt</span>
        </p>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">werden kann.</span>
        </p>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">Durchmesser bis 16 mm.</span>
        </p>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">Aufbringen einer zementgebundenen, EP- modifizierten,</span>
        </p>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">3- komponentigen Beschichtung als Korrosionsschutz und</span>
        </p>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">ggf. Haftbrücke auf die vorbereiteten Bewehrungsstähle/</span>
        </p>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">Stahlbauteile.</span>
        </p>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">Schichtdicke min. 1 mm</span>
        </p>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">Arbeitsgänge 2</span>
        </p>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">Verbrauch: ca. 2,2 kg/m2 je mm Schichtdicke</span>
        </p>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">Anforderung an das Produkt:</span>
        </p>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">Die Wirksamkeit ist über Grundprüfungen</span>
        </p>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">nach DIN EN 13396 Prüfverfahren - Messung des</span>
        </p>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">Eindringens von Chloridionen nachzuweisen.</span>
        </p>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">Offenzeit bei Einsatz als Haftbrücke 2 Stunden.</span>
        </p>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">An den freiliegenden Bewehrungsstäben ist der</span>
        </p>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">Korrosionsschutz im Übergangsbereich zum Beton intensiv</span>
        </p>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">einzuarbeiten, so dass der Korrosionsschutz in die</span>
        </p>
        <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span style="font-family:Arial;font-size:10pt;">nicht freiliegenden Kontaktflächen eindringen kann.</span>
        </p>
       </LblTx>
       <BoQBody>
        <Itemlist>
         <Item ID="ID_66" RNoPart="0010">
          <Provis>WithTotal</Provis>
          <Qty>1.000</Qty>
          <QU>m2</QU>
          <CtlgAssign>
           <CtlgID>CtlgID_B12</CtlgID>
           <CtlgCode>124</CtlgCode>
          </CtlgAssign>
          <Description ID="8C5B9C1E-4A47-4B6A-9334-900F4CF607F5">
           <StLNo Type="StLK">1912410899110311</StLNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text textWidth="19.998cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Betonunterlage nach Unterlagen des AG vorbereiten. Vor-</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">bereitete Flächen säubern.</span>
              </p>
              <TextComplement MarkLbl="21" Kind="Owner" ArtChrIdent="32767">
               <ComplCaption>
                <span style="font-family:Arial;font-size:10pt;">Bauteil </span>
               </ComplCaption>
               <ComplBody>
                <span style="font-family:Arial;font-size:10pt;">Parkdeck, </span>
                <br/>
                <span style="font-family:Arial;font-size:10pt;">Rohdecke mit Betonschäden und verbliebenen Bitumenresten.</span>
               </ComplBody>
               <ComplTail/>
              </TextComplement>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Oberfläche waagerecht bis 20 v.H. geneigt.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Ausführung in Teilflächen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Vorbereitungsverfahren = Betonunterlage fräsen und</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">strahlen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Beschichtungen, Voranstrich und Nachbehandlungsfilme</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">sowie Verunreinigungen entfernen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Abfall entsorgen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Betonunterlage vorbereiten Oberfl. waager. Teilflächen fräsen/strahlen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="ID_67" RNoPart="0020">
          <Provis>WithTotal</Provis>
          <Qty>1.000</Qty>
          <QU>m2</QU>
          <CtlgAssign>
           <CtlgID>CtlgID_B12</CtlgID>
           <CtlgCode>124</CtlgCode>
          </CtlgAssign>
          <Description ID="995E4A9F-97CE-4C6A-A67A-D1D4C6D29725">
           <StLNo Type="StLK">1912410899110171</StLNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text textWidth="19.998cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Betonunterlage nach Unterlagen des AG vorbereiten. Vor-</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">bereitete Flächen säubern.</span>
              </p>
              <TextComplement MarkLbl="21" Kind="Owner" ArtChrIdent="32767">
               <ComplCaption>
                <span style="font-family:Arial;font-size:10pt;">Bauteil </span>
               </ComplCaption>
               <ComplBody>
                <span style="font-family:Arial;font-size:10pt;">Parkdeck, </span>
                <br/>
                <span style="font-family:Arial;font-size:10pt;">Rohdecke mit Betonschäden</span>
               </ComplBody>
               <ComplTail/>
              </TextComplement>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Oberfläche waagerecht bis 20 v.H. geneigt.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Ausführung in Teilflächen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Vorbereitungsverfahren = Betonunterlage abstemmen und</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">strahlen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Beton abtragen, Abtragstiefe über 2 bis 3 cm.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Abfall entsorgen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Betonunterlage vorbereiten Oberfl. waager. Teilflächen abstemm./strahl</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="ID_68" RNoPart="0030">
          <Provis>WithTotal</Provis>
          <Qty>1.000</Qty>
          <QU>m2</QU>
          <CtlgAssign>
           <CtlgID>CtlgID_B12</CtlgID>
           <CtlgCode>124</CtlgCode>
          </CtlgAssign>
          <Description ID="295CF5C2-0505-4287-9833-07520E933A27">
           <StLNo Type="StLK">1912410899110521</StLNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text textWidth="19.998cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Betonunterlage nach Unterlagen des AG vorbereiten. Vor-</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">bereitete Flächen säubern.</span>
              </p>
              <TextComplement MarkLbl="21" Kind="Owner" ArtChrIdent="32767">
               <ComplCaption>
                <span style="font-family:Arial;font-size:10pt;">Bauteil </span>
               </ComplCaption>
               <ComplBody>
                <span style="font-family:Arial;font-size:10pt;">Rohdecke im Bereich von Betonschäden</span>
               </ComplBody>
               <ComplTail/>
              </TextComplement>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Oberfläche waagerecht bis 20 v.H. geneigt.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Ausführung in Teilflächen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Vorbereitungsverfahren = Betonunterlage mit festen</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Strahlmitteln strahlen bei gleichzeitigem Absaugen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Zementschlämme und minderfeste Schichten entfernen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Abfall entsorgen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Betonunterlage vorbereiten Oberfl. waager. Teilflächen strahlen/absaug</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="ID_69" RNoPart="0040">
          <Provis>WithTotal</Provis>
          <Qty>1.000</Qty>
          <QU>m2</QU>
          <CtlgAssign>
           <CtlgID>CtlgID_B12</CtlgID>
           <CtlgCode>124</CtlgCode>
          </CtlgAssign>
          <Description ID="BA0E9F25-2D2C-48C9-BFF7-2A7FFB2B61D7">
           <StLNo Type="StLK">19124308991201</StLNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text textWidth="19.998cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Haftbrücke auf vorbereiteter Betonunterlage nach Unter-</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">lagen des AG herstellen.</span>
              </p>
              <TextComplement MarkLbl="21" Kind="Owner" ArtChrIdent="32767">
               <ComplCaption>
                <span style="font-family:Arial;font-size:10pt;">Bauteil </span>
               </ComplCaption>
               <ComplBody>
                <span style="font-family:Arial;font-size:10pt;">Rohdecke im Bereich von Betonschäden</span>
               </ComplBody>
               <ComplTail/>
              </TextComplement>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Oberfläche waagerecht bis 20 v.H. geneigt.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Stoff = Zementmörtel mit Kunststoffzusatz (RM).</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Ausführung in Teilflächen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Haftbrücke herstellen Oberfl.waager. RM-Mörtel Teilflächen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="ID_70" RNoPart="0050">
          <Provis>WithTotal</Provis>
          <Qty>1.000</Qty>
          <QU>m2</QU>
          <CtlgAssign>
           <CtlgID>CtlgID_B12</CtlgID>
           <CtlgCode>124</CtlgCode>
          </CtlgAssign>
          <Description ID="43DB37E3-7C28-4DE8-BFF9-DD5060E24DF1">
           <StLNo Type="StLK">19124328991121</StLNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text textWidth="19.998cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Zementmörtel/Beton mit Kunststoffzusatz (RM/RC) auf</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">vorbereiteter Betonunterlage nach Unterlagen des AG</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">einbauen. Ggf. erforderliche Schalung herstellen. Haft-</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">brücke wird gesondert vergütet.</span>
              </p>
              <TextComplement MarkLbl="21" Kind="Owner" ArtChrIdent="32767">
               <ComplCaption>
                <span style="font-family:Arial;font-size:10pt;">Bauteil </span>
               </ComplCaption>
               <ComplBody>
                <span style="font-family:Arial;font-size:10pt;">Rohdecke im Bereich von Betonschäden</span>
               </ComplBody>
               <ComplTail/>
              </TextComplement>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Oberfläche waagerecht bis 20 v. H. geneigt.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Betonersatzsystem = RM.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Schichtdicke über 2 bis 3 cm.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Ausführung in Teilflächen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Zementmörtel/Beton (RM/RC) einbauen Oberfl.waager. RM Dicke über 2-3 c</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="ID_71" RNoPart="0060">
          <Provis>WithTotal</Provis>
          <Qty>5.000</Qty>
          <QU>m</QU>
          <CtlgAssign>
           <CtlgID>CtlgID_B12</CtlgID>
           <CtlgCode>124</CtlgCode>
          </CtlgAssign>
          <Description ID="BC604197-F627-4678-88FE-B8DDE8552964">
           <StLNo Type="StLK">1912411813</StLNo>
           <CompleteText>
            <DetailTxt>
             <Text textWidth="19.998cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Freiliegenden Betonstahl unterschiedlicher Durchmesser</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">vorbereiten. Abfall entsorgen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Durchmesser bis 16 mm.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Norm-Reinheitsgrad = Sa 2 1/2.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Betonstahl vorbereiten DU bis 16 mm ReinG Sa 2 1/2</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="ID_72" RNoPart="0070">
          <Provis>WithTotal</Provis>
          <Qty>5.000</Qty>
          <QU>m</QU>
          <Description ID="0564191F-B76C-41D8-A3C5-C8DC4E805E18">
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text textWidth="9.997cm">
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Beschichtungsstoff auf freiliegenden Betonstahl und</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">ggf. andere Stahlteile auftragen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Betonstahl vorbereiten wird gesondert vergütet.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Beschichtung als Korrosionsschutz von an/ in der</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Oberfläche der Fahrbahnplatte aus Stahlbeton</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">freigelegten bzw. freiliegender Bewehrung, die aufgrund</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">des unveränderten Beibehalten der vorhandenen Höhen und</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Gefälle nicht mit einem Betonersatz für einer</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">ausreichenden Betondeckung (min. 3,0 cm) überdeckt</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">werden kann.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Durchmesser bis 16 mm.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Aufbringen einer zementgebundenen, EP- modifizierten,</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">3- komponentigen Beschichtung als Korrosionsschutz und</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">ggf. Haftbrücke auf die vorbereiteten Bewehrungsstähle/</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Stahlbauteile.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <TextComplement MarkLbl="61" Kind="Owner" ArtChrIdent="0">
               <ComplCaption>
                <span style="font-family:Arial;font-size:10pt;">Beschichtungsstoff </span>
               </ComplCaption>
               <ComplBody>
                <span style="font-family:Arial;font-size:10pt;">Sika Top Armatec 100 EpoCem odergleichwertiges nach Wahl AN</span>
               </ComplBody>
               <ComplTail>
                <span style="font-family:Arial;font-size:10pt;">  </span>
               </ComplTail>
              </TextComplement>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Schichtdicke min. 1 mm</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Arbeitsgänge 2</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Verbrauch: ca. 2,2 kg/m2 je mm Schichtdicke</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Anforderung an das Produkt:</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Die Wirksamkeit ist über Grundprüfungen</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">nach DIN EN 13396 Prüfverfahren - Messung des</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Eindringens von Chloridionen nachzuweisen.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Offenzeit bei Einsatz als Haftbrücke 2 Stunden.</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">An den freiliegenden Bewehrungsstäben ist der</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">Korrosionsschutz im Übergangsbereich zum Beton intensiv</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">einzuarbeiten, so dass der Korrosionsschutz in die</span>
              </p>
              <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;">nicht freiliegenden Kontaktflächen eindringen kann.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Beschichtungsstoff auf BSt auftrag.</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
        </Itemlist>
       </BoQBody>
      </BoQCtgy>
     </BoQBody>
    </BoQCtgy>
   </BoQBody>
  </BoQ>
 </Award>
</GAEB>
