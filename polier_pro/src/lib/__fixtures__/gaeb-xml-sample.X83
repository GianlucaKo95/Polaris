  <BoQ ID="ID_BoQ1">
   <BoQInfo>
    <Name/>
    <LblBoQ>Instandsetzung Parkdeck- schadhafte Betonplatten</LblBoQ>
    <Date>2026-01-12</Date>
    <OutlCompl>AllTxt</OutlCompl>
    <BoQBkdn>
     <Type>BoQLevel</Type>
     <LblBoQBkdn>Gewerk</LblBoQBkdn>
     <Length>2</Length>
     <Num>Yes</Num>
     <Alignment>left</Alignment>
    </BoQBkdn>
    <BoQBkdn>
     <Type>BoQLevel</Type>
     <LblBoQBkdn>Titel</LblBoQBkdn>
     <Length>2</Length>
     <Num>Yes</Num>
     <Alignment>left</Alignment>
    </BoQBkdn>
    <BoQBkdn>
     <Type>Item</Type>
     <LblBoQBkdn>Teillung</LblBoQBkdn>
     <Length>4</Length>
     <Num>Yes</Num>
     <Alignment>left</Alignment>
    </BoQBkdn>
    <BoQBkdn>
     <Type>Index</Type>
     <LblBoQBkdn>Index</LblBoQBkdn>
     <Length>1</Length>
     <Num>No</Num>
     <Alignment>left</Alignment>
    </BoQBkdn>
    <LblTime>Minuten</LblTime>
    <Ctlg>
     <CtlgID>CtlgID_B12</CtlgID>
     <CtlgType>work category</CtlgType>
     <CtlgName>Leistungsbereich</CtlgName>
    </Ctlg>
   </BoQInfo>
   <BoQBody>
    <Remark ID="ID_287">
     <Description ID="4F9B3C65-70DC-459B-94FA-A3C90C1CD98E">
      <CompleteText>
       <DetailTxt>
        <Text textWidth="9.999cm">
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Die folgenden Vorbemerkungen gelten für alle Teile des</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Leistungsverzeichnis &#x22;Instandsetzung schadhafter Betonplatten im Eingangsbereich und Rinne neben E- Ladesäule&#x22;, Anlage 1</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">im Kaufland Bebelplatz 2 in 09599 Freiberg/Sachsen.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Die nachfolgenden Positionen beinhalten die Instandsetzung der schadhaften Betonplatten einschließlich des Abdichtungsanschlusses an den aufgehenden Bauteilen.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Das LV für die ausgeschriebene Instandsetzung</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">gilt nur unter gleichzeitiger Beachtung und Anwendung</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">der beiliegenden Zeichnungen.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Auf die Beachtung und Einhaltung der Kaufland Baubeschreibung (KABA) in der aktuell gültigen Version wird für die Ausführung der Instandsetzung ausdrücklich hingewiesen.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Vor Abgabe des Angebotes ist eine Ortsbesichtigung</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">erforderlich.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Forderungen, die sich aus Unkenntnis der örtlichen</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Situation ergeben, können nachträglich nicht</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">berücksichtigt werden.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Über Unklarheiten im Leistungsverzeichnis hat sich der</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Bewerber bei :</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Kaufland Dienstleistung GmbH &#x26; Co.KG,</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Kirchweg 3, 06721 Meineweh</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">bzw. für die Instandsetzungsarbeiten bei:</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Dr.- Ing. Peter A. Kugler und Franke GmbH</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Pfingstweide 1</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">04179 Leipzig</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">zu unterrichten.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Alle Leistungen umfassen die Lieferung der</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">dazugehörigen Stoffe und Bauteile, einschließlich</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Abladen und Lagern auf der Baustelle, soweit in den</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Positionen nicht ausdrücklich etwas anderes bestimmt</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">ist.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Die Beweissicherung ist Sache des Auftragnehmers und</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">ist gemeinsam mit dem Auftraggeber durchzuführen.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Der AN erstellt hierzu eine entsprechende</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Dokumentationsunterlage die beim AG vor Baubeginn zu</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">hinterlegen ist.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Außerhalb des zugewiesenen Baubereiches stehen dem AG</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">keine bzw. nur eingeschränkte Lager- und Arbeitsplätze</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">zu Verfügung.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Alle eventuellen Beschädigungen am Parkhaus und</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">seinem Umfeld sind während bzw. nach Beendigung der</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Bauarbeiten unverzüglich zu beseitigen und der</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">ursprüngliche Zustand ist wieder herzustellen.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Dem AN unterliegt hierzu die Beweispflicht.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Die Kosten sind mit den Preisen der</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Baustelleneinrichtung abgegolten.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Der Baubeginn der Instandsetzungsmaßnahme richtet sich</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">nach den Anforderungen und Abläufen des AG.</span>
         </p>
        </Text>
       </DetailTxt>
       <OutlineText>
        <OutlTxt>
         <TextOutlTxt>
          <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
           <span>VORBEMERKUNG</span>
          </p>
         </TextOutlTxt>
        </OutlTxt>
       </OutlineText>
      </CompleteText>
     </Description>
    </Remark>
    <Remark ID="ID_1">
     <Description ID="66D5925A-9012-4B65-81C1-397FD9001628">
      <CompleteText>
       <DetailTxt>
        <Text textWidth="9.997cm">
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Mit den nachfolgenden Instandsetzungsleistungen sollen im Eingangsbereich ca. 5  sowie 1,5 stark schadhafte Betonplatten an der Rinne zur E- Ladesäule erneuert werden.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Für die Instandsetzung ist der Baubereich für den Kundenverkehr gesperrt. Die Verkehrssicher Absperrung des Bauabschnitts ist Sache des AN. Die restliche Parkdeckfläche ist für den Kundenverkehr in Betrieb.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Für den Materialtransport sowie den Abtransport der Abbruchmengen ist ein geeignetes Konzept mit Transportwegen vom AN zu erstellen. Auf den uneingeschränkten Kundenverkehr im Parkdeckbereich ist diesbezüglich besonders zu achten. </span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Die zum Einsatz kommende Technik darf die zulässigen</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Belastungen und Belastungsannahmen des Parkdecks nicht</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">überschreiten.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Abtrags- und Abbruchmassen sind daher umgehend vom</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Parkdeck abzutransportieren.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Abtrags- und Untergrundvorbereitungsarbeiten sind mit</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">leichter Kleintechnik ohne Erschütterungen,</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Zerstörungen am Betongefüge der Stahlbetondeckenplatte</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">und des -Tragwerks auszuführen.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Des Weiteren sind aufgrund der innerstädtischen Lage</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">mit Gebäude mit Wohneinheiten im Umfeld möglichst</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">geräuscharme Verfahren anzuwenden.</span>
         </p>
        </Text>
       </DetailTxt>
       <OutlineText>
        <OutlTxt>
         <TextOutlTxt>
          <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
           <span>VORBEMERKUNG Instandsetzung</span>
          </p>
         </TextOutlTxt>
        </OutlTxt>
       </OutlineText>
      </CompleteText>
     </Description>
    </Remark>
    <Remark ID="ID_2">
     <Description ID="27BCF546-54A4-4673-9B92-C1D61989ABEF">
      <CompleteText>
       <DetailTxt>
        <Text textWidth="9.997cm">
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Während der Bauausführung ist ein ausreichend qualifizierter, deutsch sprechender Bauleiter für die Baustelle zu benennen.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Der Bauleiter hat mindestens an den turnusmäßigen Bauberatungen vor Ort teilzunehmen und ist Absprechpartner für den AG und die BÜ für die Belange der Parkdeckinstandsetzung.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Das Ausführen, Prüfen und Überwachen von Instandsetzungsarbeiten nach der RiLi SIB bzw. der TR Instandhaltung erfordern von Unternehmen den Einsatz einer qualifizierten Führungskraft, eines Bauleiters und von Baustellenfachpersonal, die mit ausreichenden Kenntnissen und Erfahrungen die ordnungsgemäße Ausführung, Überwachung und Dokumentation der Instandsetzungsarbeiten sicherstellen. </span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Die Qualifikation zur Betoninstandsetzung ist durch das Vorlegen von SIVV-Scheinen nachzuweisen.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Die Kosten für den Personaleinsatz für den Bauleiter und Polier ist in die BE einzukalkulieren. Der Einsatz des Baustellenfachpersonals ist in die jeweiligen Instandsetzungspositionen einzukalkulieren.</span>
         </p>
        </Text>
       </DetailTxt>
       <OutlineText>
        <OutlTxt>
         <TextOutlTxt>
          <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
           <span>VORBEMERKUNG Bauausführung</span>
          </p>
         </TextOutlTxt>
        </OutlTxt>
       </OutlineText>
      </CompleteText>
     </Description>
    </Remark>
    <Remark ID="ID_3">
     <Description ID="7420C76A-E5B6-43D8-BF30-59706061E030">
      <CompleteText>
       <DetailTxt>
        <Text textWidth="9.999cm">
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Anschlussmöglichkeiten an Ver- und Entsorgungsleitungen</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">stellt der AG nicht zur Verfügung.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Die Anschlüsse einschließlich Zähler und Verbrauch sind</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">vom AN auf seine Kosten zu liefern, herzustellen, zu</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">unterhalten und nach Beendigung der Baumaßnahme</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">abzubauen.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Die Kosten sind in die entsprechenden Einheitspreise</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">einzukalkulieren.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Einläufe und Entwässerungsleitungen sind vor</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Verunreinigungen mit Abbruchgut, Harzen usw. zu</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">schützen.</span>
         </p>
        </Text>
       </DetailTxt>
       <OutlineText>
        <OutlTxt>
         <TextOutlTxt>
          <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
           <span>VORBEMERKUNG Medien und Entwässerung</span>
          </p>
         </TextOutlTxt>
        </OutlTxt>
       </OutlineText>
      </CompleteText>
     </Description>
    </Remark>
    <Remark ID="ID_4">
     <Description ID="177454DD-2654-44CF-8AD5-A6D8F0452AA0">
      <CompleteText>
       <DetailTxt>
        <Text textWidth="19.997cm">
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Alle ausgeschriebenen Bedarfspositionen mit Grundpreis</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">(GP) sind in die Angebotssumme einzurechnen und gehen</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">somit in die Wertung des Angebots mit ein.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Ein Vergütung von Bedarfspositionen erfolgt nur nach</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">ausdrücklicher Anweisung zu deren Ausführung durch</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">den AG.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Dies trifft auch auf alle LV- Positionen deren</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Beauftragung nur nach Anweisung oder in Absprache mit</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">dem AG erfolgen.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Die Anweisung zur Ausführung dieser Positionen muss</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">schriftlich vorliegen !</span>
         </p>
        </Text>
       </DetailTxt>
       <OutlineText>
        <OutlTxt>
         <TextOutlTxt>
          <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
           <span>VORBEMERKUNG Preisbildung</span>
          </p>
         </TextOutlTxt>
        </OutlTxt>
       </OutlineText>
      </CompleteText>
     </Description>
    </Remark>
    <Remark ID="ID_5">
     <Description ID="B721BA35-5E4A-49BD-8440-0DBCAFC9C31A">
      <CompleteText>
       <DetailTxt>
        <Text textWidth="9.997cm">
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Die Betonfahrbahnplatten sind nach der aktuell gültigen Kaufland Baubeschreibung (KABA)  herzustellen. Ausführungsdetails können der KABA entnommen werden.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Die jeweiligen Ausführungsbeschreibungen sind in den einzelnen Leistungspositionen erläutert.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Arial;font-size:10pt;">Die Ausführung der Betonfahrbahnplatten weicht von der KABA insofern ab, dass entsprechend des Bestandes auf den Einbau einer Randeinfassung aus Stahl- oder Kunststoffwinkeln an den Fahrbahnplatten verzichtet wird und der Abdichtungsanschluss an den aufgehenden Bauteilen mit einer Abdichtung aus Flüssigkunststoff und Vlieseinlage gemäß LV-Position ausgeführt wird.</span>
         </p>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
         <p style="font-family:Arial;font-size:10pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
