             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Fußleiste mit dauerelast. Abschluss herstellen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
